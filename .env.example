# ── LLM：二选一 ──
# ark = 火山方舟 OpenAI 兼容接口（默认，需下方 VITE_ARK_API_KEY）
# ollama = 本机 Ollama，与 `ollama serve` 默认 http://127.0.0.1:11434 通信
VITE_LLM_PROVIDER=ark

# 方舟：控制台创建推理接入点，API Key 与模型 ID（与控制台一致）
# 勿将真实 Key 提交到仓库；本地复制为 .env 后填写
VITE_ARK_API_KEY=your_ark_api_key_here
VITE_ARK_MODEL=doubao-seed-2-0-lite-260215

# chat = POST .../chat/completions（OpenAI 兼容）；responses = POST .../responses（如 Doubao-Seed 控制台示例）
# VITE_ARK_API_KIND=responses

# 可选：覆盖默认接口（一般无需改）
# VITE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 开发时若浏览器直连被 CORS 拦截，可改为走 Vite 代理：
# VITE_ARK_BASE_URL=/ark-api/api/v3
# VITE_ARK_TEMPERATURE=0.8
# VITE_ARK_MAX_TOKENS=1024
# VITE_ARK_TOP_P=0.95

# ── Ollama（仅 VITE_LLM_PROVIDER=ollama 时生效）──
# 模型名与 ollama list 中一致，例如 qwen2.5:9b、qwen3:8b
# VITE_OLLAMA_MODEL=qwen2.5:9b
# 开发环境默认走 Vite 代理 /ollama，一般无需改。若直连可写：http://127.0.0.1:11434
# VITE_OLLAMA_BASE_URL=
# VITE_OLLAMA_TEMPERATURE=0.8
# VITE_OLLAMA_NUM_PREDICT=1024
# VITE_OLLAMA_TOP_P=0.95
# 千问3 等「思考模式」：设为 true 开启；不设或 false 则请求中带 think:false
# VITE_OLLAMA_THINK=false
